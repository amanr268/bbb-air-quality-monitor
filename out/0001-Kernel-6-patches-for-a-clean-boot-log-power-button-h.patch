diff --git a/config/logind-aqm-power.conf b/config/logind-aqm-power.conf
new file mode 100644
index 0000000..b3480c0
--- /dev/null
+++ b/config/logind-aqm-power.conf
@@ -0,0 +1,8 @@
+# Installed as /etc/systemd/logind.conf.d/aqm-power.conf
+# A short tap of the power button no longer powers the board off:
+# a glitch on the button line did exactly that on 2026-11-23 at 04:17.
+# Hold the button for ~5 s to power off. Power-on is still one tap
+# (the TPS65217 PMIC handles that in hardware).
