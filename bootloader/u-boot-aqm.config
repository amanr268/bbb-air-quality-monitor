# Custom U-Boot for the BBB air-quality monitor
# source: https://github.com/beagleboard/u-boot.git  branch v2022.04-bbb.io-am335x-am57xx
# build:  make CROSS_COMPILE=arm-linux-gnueabihf- am335x_evm_defconfig
#         cat bootloader/u-boot-aqm.config >> .config
#         make CROSS_COMPILE=arm-linux-gnueabihf- olddefconfig && make CROSS_COMPILE=arm-linux-gnueabihf- -j$(nproc)
# install (eMMC raw, SD keeps the stock U-Boot as fallback: hold BOOT/S2):
#         sudo dd if=MLO of=/dev/mmcblk1 bs=128k seek=1 count=1 conv=fsync
#         sudo dd if=u-boot-dtb.img of=/dev/mmcblk1 bs=384k seek=1 count=3 conv=fsync
CONFIG_LOCALVERSION="-aqm"
CONFIG_BOOTDELAY=2
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="echo; echo '*** AQM custom U-Boot - BeagleBone Black Wireless air-quality monitor ***'; echo"
