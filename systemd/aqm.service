# Air-quality monitor pipeline.
# Install:  sudo cp systemd/aqm.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now aqm
[Unit]
Description=BBB air-quality monitor (sense/capture/convert/compare/report)
# start early: needs only /, journald, mqueue and a restored clock (not /boot/firmware)
DefaultDependencies=no
After=-.mount systemd-remount-fs.service systemd-journald.socket dev-mqueue.mount time-set.target
Wants=time-set.target
Conflicts=shutdown.target
Before=shutdown.target
# 5 failed starts within 10 min = something is badly wrong: reboot the board
StartLimitIntervalSec=600
StartLimitBurst=5
StartLimitAction=reboot

[Service]
Type=notify
# READY / WATCHDOG come from aqm_report, a child of the script
NotifyAccess=all
User=aman
WorkingDirectory=/home/aman/bbb-air-quality-monitor
# udev applies device permissions late at boot (~55 s): set them now (same as its rules)
ExecStartPre=-+/home/aman/bbb-air-quality-monitor/scripts/aqm_devperm.sh
ExecStart=/home/aman/bbb-air-quality-monitor/scripts/aqm_service.sh
ExecStopPost=/bin/rm -f /dev/shm/aqm_shm /dev/mqueue/aqm_alarm
# blank the OLED whatever way the service ended (clean stop, crash, kill)
ExecStopPost=-/home/aman/bbb-air-quality-monitor/build/tools/oled_off
# why the service stopped (success / exit-code / watchdog ...): the OLED fault page shows a freeze
ExecStopPost=-/bin/sh -c 'echo "$$(date +%%s) $$SERVICE_RESULT $$EXIT_CODE $$EXIT_STATUS" > /home/aman/bbb-air-quality-monitor/data/last_stop'
# no sample through all 5 stages for 5 s -> kill and restart
WatchdogSec=5
TimeoutStartSec=30
TimeoutStopSec=10
Restart=always
RestartSec=2
# allow SCHED_FIFO and mlockall without root
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
